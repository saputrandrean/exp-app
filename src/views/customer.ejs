<div>
  <h2>Company</h2>
  <p>This is the company page content.</p>

  <!-- CREATE FORM -->
  <h3>Add New Customer</h3>
  <form action="/company/create" method="POST">
    <label for="customer">Customer Name:</label>
    <input type="text" name="customer" id="customer" required>
    <button type="submit">Add Customer</button>
  </form>

  <hr>

  <% if (rows && rows.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Timestamp</th>
        <th>EDIT | DELETE</th>
      </tr>
    </thead>
    <tbody>
      <tbody>
        <% rows.forEach(row => { %>
        <tr>
          <td><%= row.ID %></td>
          <td><%= row.CUSTOMER_NAME %></td>
          <td><%= row.CREATED_AT %></td>
          <td>
            <!-- EDIT BUTTON -->
          <a href="/company/edit/<%= row.ID %>">Edit</a>
          |
          <!-- DELETE FORM -->
          <form action="/company/delete/<%= row.ID %>" method="POST" style="display:inline;">
            <button type="submit" onclick="return confirm('Are you sure you want to delete this customer?')">Delete</button>
          </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </tbody>
  </table>
<% } else { %>
  <p>Customer not found</p>
<% } %>
  <a href="/">Back</a>
</div>
